#!/bin/sh
# Syncphony box audio: pick the output sink named by audio= (syncphony.txt,
# via /etc/syncphony-box/config.env), keep it the default at 100% and
# unmuted, and follow hotplug. See docs/adr/0004-audio-output.md.
#
#   audio-setup apply     one-shot: wait for the PipeWire server, select the
#                         sink for audio=, make it the default at 100%
#   audio-setup monitor   apply, then re-apply whenever sinks, cards or the
#                         server change (HDMI unplugged and back, TV that
#                         was off at boot turned on later, USB DAC plugged)
#
# Never fails a boot: apply always exits 0. A missing server or a sink that
# doesn't exist (yet) is a warning — the default sink is left alone until
# the output appears and the monitor switches to it. PipeWire runs as the
# kiosk user's user services (linger; enabled at image build by
# rootfs/steps/10-audio.sh).
#
# Test hooks (unit defaults shown): SB_PACTL (pactl), SB_CONFIG_ENV
# (/etc/syncphony-box/config.env), SB_SLEEP (sleep).

PACTL=${SB_PACTL:-pactl}
CONFIG_ENV=${SB_CONFIG_ENV:-/etc/syncphony-box/config.env}
SLEEP=${SB_SLEEP:-sleep}

# The kiosk waits for the audio unit the way it waits for
# network-online.target: bounded, never a hang.
SERVER_WAIT_SECS=45
# A sink that should exist (usb DAC, hdmi with the TV on) gets this long to
# appear before this round gives up; the monitor re-applies when it shows.
SINK_WAIT_SECS=8

log() { echo "audio-setup: $*" >&2; }

# PipeWire's pulse socket lives in the user's runtime dir. System services
# get no PAM environment, so derive it from the uid.
if [ -z "${XDG_RUNTIME_DIR:-}" ]; then
	XDG_RUNTIME_DIR="/run/user/$(id -u)"
	export XDG_RUNTIME_DIR
fi

wait_for_server() {
	i=0
	while [ "$i" -lt "$SERVER_WAIT_SECS" ]; do
		"$PACTL" info >/dev/null 2>&1 && return 0
		"$SLEEP" 1
		i=$((i + 1))
	done
	return 1
}

# "pactl list sinks" -> one line per sink: <name> TAB <device.bus> TAB
# <lowercase identifying text>. The match text carries the whole sink
# stanza (names, descriptions, ALSA properties), because sink *names*
# themselves flip between e.g. hdmi-stereo and stereo-fallback depending
# on the TV's ELD — the ALSA strings inside don't.
sinks_data() {
	"$PACTL" list sinks 2>/dev/null | awk '
		function emit() { if (name != "") print name "\t" bus "\t" blob }
		/^Sink #/ {
			emit()
			name = ""; bus = ""; blob = ""
		}
		{
			line = $0
			gsub(/^[ \t]+/, "", line)
			blob = blob " " tolower(line)
			if (line ~ /^Name:/) {
				sub(/^Name:[ \t]*/, "", line)
				name = line
			} else if (line ~ /^device\.bus = /) {
				sub(/^device\.bus = /, "", line)
				gsub(/"/, "", line)
				bus = tolower(line)
			}
		}
		END { emit() }
	'
}

# The single stanza for one sink name (tabs kept), for the current-state
# checks: setting the same volume again would fire the events that wake
# the monitor in a loop.
sink_block() {
	"$PACTL" list sinks 2>/dev/null | awk -v want="$1" '
		/^Sink #/ { inblk = 0 }
		/^\tName: / {
			line = $0
			sub(/^\tName: */, "", line)
			if (line == want) inblk = 1
		}
		inblk { print }
	'
}

# Whether this is a Pi (its vc4/bcm2835 audio devices): the PC-only
# HDMI handling below never touches a Pi's cards.
on_pi() {
	{ "$PACTL" list sinks; "$PACTL" list cards; } 2>/dev/null |
		grep -qiE 'bcm2835|vc4'
}

# Whether a sink's port reports a display plugged in (PC HDMI/DP). An
# empty name, or a Pi sink, is "not known to be plugged".
sink_plugged() {
	[ -n "$1" ] || return 1
	sink_block "$1" | grep -q ', available)'
}

# Print the pulse sink name for audio=$1, or nothing. Markers are matched
# against each sink's identifying text in order; the primary HDMI markers
# are the vc4 driver's PCM names ("bcm2835 HDMI 1" = HDMI0, the port next
# to USB-C power; "bcm2835 HDMI 2" = HDMI1) — the same on Pi 4 and Pi 5.
# No silent wrong-port fallback on a Pi: nothing matching means a warning
# upstream. A PC (the x86 box, MAD-846) has no fixed port names, so
# there, and only where no vc4 sink exists at all, hdmi and hdmi2 are the
# first and second built-in HDMI/DisplayPort sinks in PipeWire's order.
pick_sink() {
	audio=$1
	data=$(sinks_data)
	[ -n "$data" ] || return 0

	case $audio in
		hdmi)
			set -- 'bcm2835 hdmi 1' 'vc4-hdmi-0' 'hdmi0'
			;;
		hdmi2)
			set -- 'bcm2835 hdmi 2' 'vc4-hdmi-1' 'hdmi1'
			;;
		analog)
			# The Pi 4 jack (the Pi 5 has none), or a PC's built-in
			# analog output; never a USB headset whose text also says
			# "headphones".
			printf '%s\n' "$data" | awk -F '\t' '
				$2 != "usb" && (index($3, "headphone") ||
					(index($3, "bcm2835") && !index($3, "hdmi")) ||
					(index($3, "analog") && !index($3, "hdmi"))) {
					print $1; exit
				}
			'
			return 0
			;;
		usb)
			# The first USB audio device.
			usb_sink=$(printf '%s\n' "$data" |
				awk -F '\t' '$2 == "usb" { print $1; exit }')
			if [ -n "$usb_sink" ]; then
				printf '%s\n' "$usb_sink"
			else
				printf '%s\n' "$data" |
					awk -F '\t' 'index($3, "usb") { print $1; exit }'
			fi
			return 0
			;;
		*)
			return 0
			;;
	esac

	for marker in "$@"; do
		choice=$(printf '%s\n' "$data" |
			awk -F '\t' -v m="$marker" 'index($3, m) { print $1; exit }')
		if [ -n "$choice" ]; then
			printf '%s\n' "$choice"
			return 0
		fi
	done

	# Not a Pi.
	case $data in
		*bcm2835*|*vc4*) return 0 ;;
	esac
	# A PC has one HDMI/DisplayPort output per port (a laptop: one per
	# USB-C port), and nothing says which is "first": for hdmi, take the
	# one with a display plugged in (its port reports available).
	if [ "$audio" = hdmi ]; then
		plugged=$(printf '%s\n' "$data" | awk -F '\t' '
			$2 != "usb" && index($3, "hdmi") && index($3, ", available)") { print $1; exit }
		')
		if [ -n "$plugged" ]; then
			printf '%s\n' "$plugged"
			return 0
		fi
	fi
	# Otherwise the nth built-in HDMI/DisplayPort sink (n = 1 for hdmi,
	# 2 for hdmi2): the TV may be off, so its port says nothing.
	n=1
	[ "$audio" = hdmi2 ] && n=2
	printf '%s\n' "$data" | awk -F '\t' -v n="$n" '
		$2 != "usb" && index($3, "hdmi") && ++seen == n { print $1; exit }
	'
	return 0
}

# A PC's card shows only the outputs of its active profile, and
# WirePlumber prefers the analog one (a laptop's speakers), so the HDMI
# output with the TV on it may not be a sink at all. Switch the card to
# an available HDMI profile ("available: yes" = a display is on that
# port), output-only first. Pi cards don't have these profiles. Prints
# the profile it switched to, or nothing.
hdmi_profile() {
	"$PACTL" list cards 2>/dev/null | awk '
		function pick() {
			# The card already on it: nothing to do (and nothing to loop on).
			p = (solo != "") ? solo : any
			if (out == "" && p != "" && p != active) out = card " " p
			solo = ""; any = ""; active = ""
		}
		/^Card #/ { if (card != "") pick(); card = ""; inprof = 0 }
		/^\tName: / { card = $2 }
		/^\tActive Profile: / { active = $3 }
		/^\tProfiles:/ { inprof = 1; next }
		/^\t[^\t]/ { inprof = 0 }
		inprof && /^\t\t/ && /available: yes\)/ {
			prof = $1
			sub(/:$/, "", prof)
			if (prof !~ /hdmi/) next
			if (prof !~ /\+/ && solo == "") solo = prof
			if (any == "") any = prof
		}
		END { if (card != "") pick(); if (out != "") print out }
	'
}

apply_once() {
	audio=hdmi
	if [ -r "$CONFIG_ENV" ]; then
		audio=$(. "$CONFIG_ENV" 2>/dev/null; printf '%s' "${AUDIO:-hdmi}")
	fi
	case $audio in
		hdmi|hdmi2|analog|usb) ;;
		*)
			log "unknown AUDIO '${audio}'; using hdmi"
			audio=hdmi
			;;
	esac

	if ! wait_for_server; then
		log "PipeWire server not up after ${SERVER_WAIT_SECS}s; leaving audio alone"
		return 0
	fi

	sink=$(pick_sink "$audio")
	if [ "$audio" = hdmi ] && ! on_pi && ! sink_plugged "$sink"; then
		# shellcheck disable=SC2046 # two words: card, profile
		set -- $(hdmi_profile)
		if [ $# -eq 2 ]; then
			log "switching ${1} to ${2} (a display is on that port)"
			"$PACTL" set-card-profile "$1" "$2" 2>/dev/null || true
			"$SLEEP" 1
			sink=$(pick_sink "$audio")
		fi
	fi
	i=0
	while [ -z "$sink" ] && [ "$i" -lt "$SINK_WAIT_SECS" ]; do
		"$SLEEP" 1
		i=$((i + 1))
		sink=$(pick_sink "$audio")
	done
	if [ -z "$sink" ]; then
		log "no sink matches audio=${audio}; leaving the default alone (the monitor switches when it appears)"
		return 0
	fi

	current=$("$PACTL" get-default-sink 2>/dev/null || true)
	if [ "$current" != "$sink" ]; then
		"$PACTL" set-default-sink "$sink" 2>/dev/null ||
			log "cannot make ${sink} the default sink"
	fi

	# 100% and unmuted, but only the calls something differs: the monitor
	# re-runs this on every sink event.
	block=$(sink_block "$sink")
	if printf '%s\n' "$block" | grep -q '^[[:space:]]*Mute: yes'; then
		"$PACTL" set-sink-mute "$sink" 0 2>/dev/null || true
	fi
	if ! printf '%s\n' "$block" | grep '^[[:space:]]*Volume: ' |
		grep -q '/ 100% /'; then
		"$PACTL" set-sink-volume "$sink" 100% 2>/dev/null || true
	fi

	log "audio=${audio}: sink ${sink} default, 100%, unmuted"
	return 0
}

monitor() {
	apply_once || true
	log "following audio device changes"
	while :; do
		"$PACTL" subscribe 2>/dev/null | while IFS= read -r event; do
			case $event in
				*"on server"*|*"on sink #"*|*"on card #"*)
					# Give WirePlumber a beat to finish (re)creating the
					# device before re-selecting.
					"$SLEEP" 2
					apply_once || true
					;;
			esac
		done
		# subscribe died: the server went away. It comes back (user units
		# restart); wait, re-apply, reconnect.
		"$SLEEP" 5
		apply_once || true
	done
}

case ${1:-apply} in
	apply) apply_once ;;
	monitor) monitor ;;
	*)
		echo "usage: audio-setup [apply | monitor]" >&2
		exit 2
		;;
esac

exit 0
