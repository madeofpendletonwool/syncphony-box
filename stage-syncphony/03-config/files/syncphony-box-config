#!/bin/sh
# Syncphony box boot config: parse /boot/firmware/syncphony.txt (the file on
# the SD card's FAT boot partition the user edits from any computer) and
# apply it. See docs/adr/0003-box-config-file.md.
#
#   syncphony-box-config parse [FILE]   print the validated config.env content
#   syncphony-box-config apply          write config.env, set the hostname,
#                                       sync the kernel cmdline video= arg
#                                       and reboot once if it changed
#
# The parse path is the one place that knows the file format; boxd takes it
# over in stage 2 and must keep this behavior — tests/syncphony-box-config.bats
# pins it. Bad values warn on stderr and fall back to defaults: a missing or
# invalid file never stops the boot.
#
# Test hooks (unit defaults shown): SB_TXT, SB_ENV, SB_CMDLINE,
# SB_HOSTNAME_CMD (run as: sh -c "$SB_HOSTNAME_CMD" x <slug>), SB_REBOOT_CMD.

TXT_DEFAULT=/boot/firmware/syncphony.txt
ENV_DEFAULT=/etc/syncphony-box/config.env
CMDLINE_DEFAULT=/boot/firmware/cmdline.txt

warn() { echo "syncphony-box-config: $*" >&2; }

trim() {
	printf '%s' "$1" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//'
}

# Emit raw key=value pairs from the file: UTF-8 BOM stripped, CRLF line
# endings accepted (people edit this file in Notepad), comments and blank
# lines skipped, whitespace around keys and values trimmed. A missing or
# unreadable file yields nothing.
raw_pairs() {
	sed -e '1s/^\xef\xbb\xbf//' -e 's/\r$//' -- "$1" 2>/dev/null |
		while IFS= read -r line || [ -n "$line" ]; do
			line=$(trim "$line")
			case $line in
				''|'#'*) continue ;;
				*=*) ;;
				*) warn "ignoring unrecognized line: ${line}"; continue ;;
			esac
			printf '%s=%s\n' "$(trim "${line%%=*}")" "$(trim "${line#*=}")"
		done
}

# "Living room TV" -> living-room-tv; anything not [a-z0-9] collapses to a
# single hyphen; leading/trailing hyphens dropped; capped at a hostname
# label's 63 characters. Empty result means the name had nothing usable.
slugify() {
	printf '%s' "$1" |
		tr '[:upper:]' '[:lower:]' |
		sed -e 's/[^a-z0-9]\{1,\}/-/g' -e 's/^\(.\{1,63\}\).*/\1/' -e 's/^-*//' -e 's/-*$//'
}

# Quote a value for config.env so the file is safe to source in POSIX sh.
sq() {
	printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

# Parse + validate. Prints the config.env content (shell-sourceable
# assignments) to stdout; warnings go to stderr. Always succeeds.
parse_env() {
	raw_pairs "$1" | {
		server_url='' name='' hostname='' audio=hdmi resolution='' rotate=0 cec=on
		while IFS= read -r pair; do
			[ -n "$pair" ] || continue
			key=$(printf '%s' "${pair%%=*}" | tr '[:upper:]' '[:lower:]')
			value=${pair#*=}
			case $key in
				server_url)
					case $value in
						http://*|https://*) server_url=$value ;;
						'') ;;
						*) warn "invalid server_url '${value}' (want https://syncphony.example.com); ignoring it" ;;
					esac
					;;
				name)
					name=$value
					hostname=$(slugify "$value")
					if [ -n "$name" ] && [ -z "$hostname" ]; then
						warn "name '${value}' has no letters or digits; leaving the hostname alone"
					fi
					;;
				audio)
					case $value in
						'') ;;
						hdmi|hdmi2|analog|usb) audio=$value ;;
						*) warn "invalid audio '${value}' (want hdmi, hdmi2, analog or usb); using ${audio}" ;;
					esac
					;;
				resolution)
					if [ -n "$value" ] &&
						! printf '%s' "$value" | grep -Eq '^[0-9]{3,5}x[0-9]{3,5}(@[0-9]{1,3})?$'; then
						warn "invalid resolution '${value}' (want e.g. 1920x1080 or 1920x1080@60); leaving it on auto"
					else
						resolution=$value
					fi
					;;
				rotate)
					value=$(printf '%s' "$value" | tr '[:upper:]' '[:lower:]')
					case $value in
						'') ;;
						0|90|180|270) rotate=$value ;;
						*) warn "invalid rotate '${value}' (want 0, 90, 180 or 270); using ${rotate}" ;;
					esac
					;;
				cec)
					value=$(printf '%s' "$value" | tr '[:upper:]' '[:lower:]')
					case $value in
						'') ;;
						on|off) cec=$value ;;
						*) warn "invalid cec '${value}' (want on or off); using ${cec}" ;;
					esac
					;;
				*)
					warn "ignoring unknown key '${key}'"
					;;
			esac
		done
		printf '# Generated by syncphony-box-config. Edit syncphony.txt on the boot partition instead.\n'
		printf 'SERVER_URL=%s\n' "$(sq "$server_url")"
		printf 'NAME=%s\n' "$(sq "$name")"
		printf 'HOSTNAME=%s\n' "$(sq "$hostname")"
		printf 'AUDIO=%s\n' "$(sq "$audio")"
		printf 'RESOLUTION=%s\n' "$(sq "$resolution")"
		printf 'ROTATE=%s\n' "$(sq "$rotate")"
		printf 'CEC=%s\n' "$(sq "$cec")"
	}
}

# The desired kernel cmdline token for resolution/rotate. The trailing D
# forces the output on, so a TV that's off at boot still gets a picture
# when it turns on. Empty output means "auto": no token at all.
video_token() {
	token=
	if [ -n "$1" ]; then
		token="video=HDMI-A-1:${1}D"
	fi
	case $2 in
		90|180|270)
			if [ -n "$token" ]; then
				token="${token},rotate=${2}"
			else
				token="video=HDMI-A-1:D,rotate=${2}"
			fi
			;;
	esac
	printf '%s' "$token"
}

cmd_apply() {
	txt=${SB_TXT:-${TXT_DEFAULT}}
	env_out=${SB_ENV:-${ENV_DEFAULT}}
	cmdline=${SB_CMDLINE:-${CMDLINE_DEFAULT}}

	content=$(parse_env "$txt")

	if mkdir -p "$(dirname "$env_out")" 2>/dev/null &&
		printf '%s\n' "$content" > "${env_out}.tmp" 2>/dev/null &&
		mv -f "${env_out}.tmp" "$env_out" 2>/dev/null; then
		:
	else
		rm -f "${env_out}.tmp" 2>/dev/null
		warn "cannot write ${env_out}; the kiosk falls back to defaults"
	fi

	HOSTNAME='' RESOLUTION='' ROTATE=''
	if [ -r "$env_out" ]; then
		. "$env_out"
	fi

	# name= sets the hostname (slugified); the box advertises it over mDNS
	# as <hostname>.local via avahi-daemon. No name= leaves whatever
	# hostname Raspberry Pi Imager set.
	if [ -n "${HOSTNAME:-}" ]; then
		if [ -n "${SB_HOSTNAME_CMD:-}" ]; then
			sh -c "${SB_HOSTNAME_CMD}" syncphony-box-config "$HOSTNAME" ||
				warn "SB_HOSTNAME_CMD failed"
		elif command -v hostnamectl >/dev/null 2>&1 &&
			hostnamectl set-hostname "$HOSTNAME"; then
			:
		else
			printf '%s\n' "$HOSTNAME" > /etc/hostname 2>/dev/null ||
				warn "cannot write /etc/hostname"
			hostname "$HOSTNAME" 2>/dev/null ||
				warn "cannot set the running hostname"
		fi
		# If avahi managed to start first, re-announce under the new name.
		systemctl try-restart avahi-daemon.service 2>/dev/null || true
	fi

	# Sync the video=HDMI-A-1:... token into the kernel command line:
	# drop any previous one, append the desired one. Changing it needs a
	# reboot, which happens exactly once — after the write the next boot
	# computes the same token and finds nothing to do.
	desired=$(video_token "${RESOLUTION:-}" "${ROTATE:-0}")
	current=$(tr -d '\r\n' < "$cmdline" 2>/dev/null || true)

	new=
	set -f
	for tok in $current; do
		case $tok in
			video=HDMI-A-1:*) ;;
			*) new="${new:+$new }$tok" ;;
		esac
	done
	set +f
	[ -n "$desired" ] && new="${new:+$new }$desired"

	if [ "$new" = "$current" ]; then
		return 0
	fi
	if printf '%s\n' "$new" > "$cmdline" 2>/dev/null; then
		warn "kernel cmdline changed (${desired:-video= removed}); rebooting once so it takes effect"
		if [ -n "${SB_REBOOT_CMD:-}" ]; then
			sh -c "${SB_REBOOT_CMD}" || true
		else
			systemctl reboot
		fi
	else
		warn "cannot write ${cmdline}; display settings stay as they are"
	fi
}

case ${1:-apply} in
	parse)
		shift
		parse_env "${1:-${SB_TXT:-${TXT_DEFAULT}}}"
		;;
	apply)
		cmd_apply
		;;
	*)
		echo "usage: syncphony-box-config [parse [FILE] | apply]" >&2
		exit 2
		;;
esac

exit 0
