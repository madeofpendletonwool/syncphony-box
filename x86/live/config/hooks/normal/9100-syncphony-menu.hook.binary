#!/bin/sh
# The ISO's boot menu (MAD-846, ADR 0013), written over live-build's own.
# BIOS (grub-pc, El Torito) and UEFI (grub-efi) both end up loading
# /boot/grub/grub.cfg, so this one file is the menu for both. live-build
# runs binary hooks from the build directory, after the bootloaders and
# before the ISO is made.
set -e

[ -d binary ] && cd binary

kernel="$(cd live && ls vmlinuz* | head -n 1)"
initrd="$(cd live && ls initrd.img* | head -n 1)"
[ -n "${kernel}" ] && [ -n "${initrd}" ] || {
	echo "9100-syncphony-menu: no kernel or initrd in live/" >&2
	exit 1
}

cat > boot/grub/grub.cfg << GRUB
# The Syncphony Box ISO (MAD-846). "Syncphony Box" is the live box: the
# system runs from this medium with its writes in RAM, and a partition
# labelled syncphony-data on the same stick keeps the pairing and setup
# across reboots. "Install to disk" puts the box on this computer's disk.
insmod all_video
set default=0
set timeout=5

menuentry "Syncphony Box" {
	linux /live/${kernel} boot=live quiet splash loglevel=3 vt.global_cursor_default=0 consoleblank=0
	initrd /live/${initrd}
}

menuentry "Install Syncphony Box to disk" {
	linux /live/${kernel} boot=live syncphony.install loglevel=3 consoleblank=0
	initrd /live/${initrd}
}
GRUB
echo "9100-syncphony-menu: boot/grub/grub.cfg written (${kernel}, ${initrd})"
