#!/bin/bash
# The x86 side of the shared customise layer (MAD-846, ADR 0013).
# live-build runs this inside the chroot after its own packages and the
# includes (x86/root, plus rootfs/ and the .deb that ./build-iso.sh puts
# in /root/syncphony-rootfs).
set -euo pipefail

# The box: the same script the Pi image's pi-gen stage runs.
/root/syncphony-rootfs/customise.sh x86 /root/syncphony-rootfs/syncphony-box.deb
rm -rf /root/syncphony-rootfs

# No /data line in the live image's fstab: a stick without a
# syncphony-data partition is normal here, and a fstab entry for a
# missing label stalls the boot on a device timeout and a failed fsck.
# The live session mounts /data itself (syncphony-live-boot.service). The
# installer writes an installed box's fstab, /data by UUID, from scratch.
sed -i '/^DATADEV[[:space:]]/d' /etc/fstab

# The image-only units (x86/root): the live session's /data and
# /boot/firmware, and the installer's boot entry.
systemctl enable syncphony-live-boot.service syncphony-installer.service

echo syncphony-box > /etc/hostname

# Every live boot (and an installed box's first boot) makes its own id;
# data-persist keeps an installed box's from then on (ADR 0007).
: > /etc/machine-id
rm -f /var/lib/dbus/machine-id

# The initramfs, now that the overlay script, its hook and the module
# list are all in place. Both the live session and the installed box boot
# this one (live-boot's scripts for boot=live, the box's for boot=overlay).
update-initramfs -u -k all
