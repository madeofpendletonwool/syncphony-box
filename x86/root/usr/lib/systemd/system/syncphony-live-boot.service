[Unit]
Description=Live session: /data and a /boot/firmware for syncphony.txt
Documentation=https://github.com/madeofpendletonwool/syncphony-box/blob/main/docs/adr/0013-x86-iso.md
# The x86 ISO's live session (MAD-846) boots from read-only media with no
# boot partition and no fstab line for /data. This mounts /data (the
# stick's syncphony-data partition, or a tmpfs) and gives boxd a
# /boot/firmware/syncphony.txt on it. data-persist restore runs after it,
# so the SSH host keys and the kiosk's profile directory exist before
# sshd and the kiosk start.
ConditionKernelCommandLine=boot=live
DefaultDependencies=no
After=local-fs.target
Before=syncphony-data-prepare.service syncphony-box-config.service boxd.service ssh.service syncphony-kiosk.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/syncphony-box/live-session

[Install]
WantedBy=multi-user.target
